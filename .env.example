# ── Frontend (apps/web) ─────────────────────────────────────────
# Kosongkan untuk mode lokal (localStorage, bisa offline).
# Isi dengan URL backend untuk mode server, mis. https://civicpulse-api.vercel.app/api/v1
VITE_API_URL=
# Aktifkan fitur AI di browser (true/false)
VITE_FEATURE_AI=true
# URL server untuk LLM (ringkasan AI dasbor). Kosong ⇒ pakai VITE_API_URL; dua-duanya kosong ⇒ tanpa LLM.
# Development: http://localhost:8787/api/v1 (jalankan npm run dev:api)
VITE_AI_URL=

# ── Backend (apps/api) — HANYA di server, jangan pernah di frontend ──
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Wajib di produksi (NODE_ENV=production ⇒ server menolak menyala bila kosong).
# Dev: PIN kosong ⇒ kab/kota '2026', provinsi '3232', pusat '1945'; JWT_SECRET kosong ⇒ acak per proses.
INSTANSI_PIN=
INSTANSI_PIN_PROVINSI=
INSTANSI_PIN_PUSAT=
JWT_SECRET=
CORS_ORIGIN=http://localhost:5173
# true HANYA di belakang reverse proxy tepercaya (Tailscale Funnel/nginx); otomatis true di Vercel.
PERCAYA_PROXY=false
# Batas percobaan PIN instansi per IP per 15 menit.
AUTH_BATAS_PER_15_MENIT=10
# Tanpa Supabase, API mengisi penyimpanan memori dengan data demo. false ⇒ mulai kosong.
DEMO_SEED=true
# LLM Groq: kunci HANYA di server (jangan pernah diberi awalan VITE_). Tier gratis TANPA kartu kredit.
GROQ_API_KEY=
# Penjaga biaya (opsional): batas per IP per menit, plafon token per hari, masa cache (menit)
AI_BATAS_PER_MENIT=5
AI_BATAS_TOKEN_HARIAN=150000
AI_CACHE_MENIT=15
AI_BATAS_FOTO_PER_MENIT=30
