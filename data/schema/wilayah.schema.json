{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civicpulse/schema/wilayah.schema.json",
  "title": "Dataset Wilayah CivicPulse",
  "type": "object",
  "required": ["versi", "ilustrasi", "diperbarui", "sumber", "wilayah"],
  "properties": {
    "versi": { "type": "string" },
    "ilustrasi": { "type": "boolean", "description": "true selama data belum diganti data asli" },
    "diperbarui": { "type": "string", "format": "date" },
    "sumber": { "type": "object", "required": ["irbi", "dibi", "bps"] },
    "wilayah": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kecamatan", "kabupaten", "lat", "lng", "miskin", "risiko", "kejadian5th"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "kecamatan": { "type": "string" },
          "kabupaten": { "type": "string" },
          "lat": { "type": "number", "minimum": -11, "maximum": 6 },
          "lng": { "type": "number", "minimum": 95, "maximum": 141 },
          "miskin": { "type": "number", "minimum": 0, "maximum": 100, "description": "% penduduk miskin (BPS)" },
          "risiko": {
            "type": "object",
            "required": ["banjir", "longsor", "jalan"],
            "additionalProperties": { "type": "number", "minimum": 0, "maximum": 100 }
          },
          "kejadian5th": {
            "type": "object",
            "required": ["banjir", "longsor", "jalan"],
            "additionalProperties": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
